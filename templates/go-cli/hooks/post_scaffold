#!/bin/bash

set -euo pipefail

cd {{ .ProjectKebab }}

go get github.com/fatih/color \
        github.com/mattn/go-isatty \
        github.com/stretchr/testify \
        github.com/urfave/cli/v3

go mod tidy
gofmt -w .

mise use --pin \
    -p . \
    aqua:gotestyourself/gotestsum \
    aqua:go-task/task \
    aqua:koalaman/shellcheck \
    aqua:goreleaser/goreleaser \
    node \
    go:golang.org/x/vuln/cmd/govulncheck

git init

# the e2e tests need node_modules and a lock file. The e2e Dockerfile installs
# the packages by itself when this step does not run.
(cd e2e && mise exec -- npm install --no-audit --no-fund) \
    || echo "npm install in e2e failed. Run it before task test:e2e:local"
