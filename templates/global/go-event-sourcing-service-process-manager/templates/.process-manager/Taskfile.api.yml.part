  transfer:
    desc: "usage: FROM=<account-id> TO=<account-id> task api:transfer -- 300"
    cmds:
      - |
        curl -s -X POST "{{.API}}/transfers" -H "{{.AUTH}}" \
          -d "{\"from\": \"${FROM}\", \"to\": \"${TO}\", \"amount\": {{default "300" .CLI_ARGS}}}" | jq

  get-transfer:
    desc: "usage: TRANSFER=<transfer-id> task api:get-transfer"
    cmds:
      - curl -s "{{.API}}/transfers/${TRANSFER}" -H "{{.AUTH}}" | jq
