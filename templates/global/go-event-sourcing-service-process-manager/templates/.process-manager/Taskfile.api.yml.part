  pay:
    desc: "usage: ID=<account-id> [IBAN=<creditor IBAN>] task api:pay -- 300"
    cmds:
      - |
        curl -s -X POST "{{.API}}/payments" -H "{{.AUTH}}" \
          -d "{\"accountId\": \"${ID}\", \"creditorIban\": \"${IBAN:-DE89370400440532013000}\", \"amount\": {{default "300" .CLI_ARGS}}}" | jq

  get-payment:
    desc: "usage: PAYMENT=<payment-id> task api:get-payment"
    cmds:
      - curl -s "{{.API}}/payments/${PAYMENT}" -H "{{.AUTH}}" | jq
