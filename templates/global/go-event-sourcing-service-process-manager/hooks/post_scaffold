#!/bin/bash

set -euo pipefail

for tool in ast-grep jq go gofmt; do
  if ! command -v "$tool" >/dev/null; then
    echo "error: adding the process manager needs $tool on PATH" >&2
    exit 1
  fi
done

parts=.process-manager
example_module=github.com/hpcsc/go-event-sourcing-service-project
module=$(go list -m)
failed=0

if [ "$module" != "$example_module" ]; then
  grep -rlF --include='*.go' "$example_module" internal cmd | xargs perl -pi -e "s#\Q$example_module\E#$module#g"
fi

# add <file> <text that is there after the change> <ast-grep rule>
add() {
  local file=$1 present=$2 rule=$3
  if grep -qF -- "$present" "$file"; then
    return
  fi
  if [ "$(ast-grep scan --inline-rules "$rule" --json "$file" | jq length)" != 1 ]; then
    echo "error: cannot find where to add '$present' in $file, add it by hand" >&2
    failed=1
    return
  fi
  ast-grep scan --inline-rules "$rule" --update-all "$file" >/dev/null 2>&1
}

block() {
  sed 's/^/  /'
}

# the function or method with this name: <function_declaration|method_declaration> <name> <indent>
named() {
  printf '%*skind: %s\n%*shas: {field: name, regex: ^%s$}\n' "$3" '' "$1" "$3" '' "$2"
}

after_last_import() {
  cat <<EOF
id: add
language: go
rule:
  pattern: \$LAST
  kind: import_spec
  nthChild: {position: 1, reverse: true}
  inside:
    kind: import_spec_list
fix: |-
  \$LAST
$(block <<<"$1")
EOF
}

after_last_statement() {
  cat <<EOF
id: add
language: go
rule:
  pattern: \$LAST
  any:
    - kind: expression_statement
    - kind: short_var_declaration
    - kind: assignment_statement
    - kind: var_declaration
    - kind: if_statement
    - kind: for_statement
    - kind: defer_statement
    - kind: go_statement
  nthChild: {position: 1, reverse: true}
  inside:
    kind: statement_list
    inside:
      kind: block
      inside:
$(named "$1" "$2" 8)
fix: |-
  \$LAST
$(block <<<"$3")
EOF
}

after_last_element() {
  cat <<EOF
id: add
language: go
rule:
  pattern: \$LAST
  kind: literal_element
  nthChild: {position: 1, reverse: true}
  inside:
    kind: literal_value
    inside:
      kind: composite_literal
      inside:
        stopBy: end
$(named "$1" "$2" 8)
fix: |-
  \$LAST,
$(block <<<"$3")
EOF
}

after_last_case() {
  cat <<EOF
id: add
language: go
rule:
  pattern: \$LAST
  any:
    - kind: type_case
    - kind: default_case
  nthChild: {position: 1, reverse: true}
  inside:
    kind: type_switch_statement
    inside:
      stopBy: end
$(named "$1" "$2" 6)
transform:
  TRIMMED:
    replace:
      source: \$LAST
      replace: "\\\\n\$"
      by: ""
fix: |-
  \$TRIMMED
$(block <<<"$3")
EOF
}

before_default() {
  cat <<EOF
id: add
language: go
rule:
  pattern: \$DEFAULT
  kind: default_case
  inside:
    kind: type_switch_statement
    inside:
      stopBy: end
$(named "$1" "$2" 6)
fix: |-
$(block <<<"$3")
  \$DEFAULT
EOF
}

after_last_field() {
  cat <<EOF
id: add
language: go
rule:
  pattern: \$LAST
  kind: field_declaration
  nthChild: {position: 1, reverse: true}
  inside:
    kind: field_declaration_list
    inside:
      kind: struct_type
      inside:
        kind: type_spec
        has: {field: name, regex: ^$1$}
fix: |-
  \$LAST
$(block <<<"$2")
EOF
}

file=internal/use_cases/account/account.go
add $file "map[uuid.UUID]hold" "$(after_last_field Account 'holds map[uuid.UUID]hold')"
add $file "a.applyHold(e)" "$(after_last_case method_declaration Apply $'case *event.HoldPlaced, *event.HoldRejected, *event.HoldReleased, *event.HoldCaptured:\n\ta.applyHold(e)')"

file=internal/use_cases/account/events.go
add $file "event.HoldPlaced]()" "$(after_last_statement function_declaration RegisterEvents 'reg.Register[event.HoldPlaced]()
reg.Register[event.HoldRejected]()
reg.Register[event.HoldReleased]()
reg.Register[event.HoldCaptured]()')"

file=internal/use_cases/account/balance/projection.go
add $file "event.HoldCaptured{}.EventType()" "$(after_last_element method_declaration EventTypes 'event.HoldCaptured{}.EventType()')"
add $file "case *event.HoldCaptured:" "$(before_default method_declaration Handle $'case *event.HoldCaptured:\n\treturn p.change(ctx, tx, payload.AccountID, -payload.Amount, evt)')"

file=internal/use_cases/register.go
for pkg in internal/use_cases/account/holds internal/use_cases/payment internal/use_cases/payment/record internal/use_cases/payment/request internal/use_cases/payment/timeout; do
  add $file "\"$module/$pkg\"" "$(after_last_import "\"$module/$pkg\"")"
done
add $file "payment.RegisterEvents(reg)" "$(after_last_statement function_declaration RegisterEvents 'payment.RegisterEvents(reg)')"
add $file "holds.Register(bus, accounts)" "$(after_last_statement function_declaration RegisterHandlers 'holds.Register(bus, accounts)

payments := payment.NewRepository(stream)
request.Register(bus, payments, accounts)
record.Register(bus, payments, payment.DefaultTimeouts, time.Now)
timeout.Register(bus, payments, payment.DefaultTimeouts, time.Now)')"
# a standard library import goes in a group of its own, and ast-grep adds only to the last group
if ! grep -qF '"time"' $file; then
  perl -0pi -e 's/^import \(\n/import (\n\t"time"\n\n/m' $file
fi

file=cmd/catchup/main.go
for pkg in internal/domain/scheduler internal/use_cases/payment internal/use_cases/payment/checks internal/use_cases/payment/deadlines internal/use_cases/payment/funding internal/use_cases/payment/holds internal/use_cases/payment/outside internal/use_cases/payment/status internal/use_cases/payment/submission internal/use_cases/payment/summary; do
  add $file "\"$module/$pkg\"" "$(after_last_import "\"$module/$pkg\"")"
done
add $file "outside.Config" "$(after_last_field Config 'Outside outside.Config')"
add $file "funding.NewReaction(" "$(after_last_element function_declaration workers 'reaction.NewReactor(funding.NewReaction(bus), checkpointStore, eventSubscription, logger, reaction.StartAtBeginning()),
reaction.NewReactor(holds.NewReaction(bus), checkpointStore, eventSubscription, logger, reaction.StartAtBeginning()),
reaction.NewReactor(checks.NewGateway(payment.NewRepository(eventStream), outside.NewClient(), cfg.Outside, logger), checkpointStore, eventSubscription, logger, reaction.StartAtBeginning()),
reaction.NewReactor(submission.NewGateway(bus, payment.NewRepository(eventStream), outside.NewClient(), cfg.Outside, logger), checkpointStore, eventSubscription, logger, reaction.StartAtBeginning()),
reaction.NewReactor(status.NewGateway(bus, payment.NewRepository(eventStream), outside.NewClient(), cfg.Outside, logger), checkpointStore, eventSubscription, logger, reaction.StartAtBeginning()),
projection.NewProjector(summary.NewProjection(), pool, checkpointStore, eventSubscription, logger),
projection.NewProjector(deadlines.NewProjection(), pool, checkpointStore, eventSubscription, logger),
scheduler.New(deadlines.NewReporter(pool, bus), logger)')"

file=internal/api/use_cases/register.go
add $file "\"$module/internal/api/use_cases/payment\"" "$(after_last_import "apiPayment \"$module/internal/api/use_cases/payment\"")"
add $file "\"$module/internal/api/use_cases/webhook\"" "$(after_last_import "\"$module/internal/api/use_cases/webhook\"")"
add $file "\"$module/internal/use_cases/payment/summary\"" "$(after_last_import "\"$module/internal/use_cases/payment/summary\"")"
add $file "apiPayment.NewHandler(" "$(after_last_element function_declaration allRoutes 'apiPayment.NewHandler(bus, summary.NewQuery(pool)),
webhook.NewHandler(bus)')"

gofmt -w internal/use_cases/account internal/use_cases/register.go cmd/catchup/main.go internal/api/use_cases/register.go

if ! grep -qF "## Process Manager Example" README.md; then
  printf '\n' >>README.md
  cat "$parts/README.md.part" >>README.md
fi
if ! grep -qF "  pay:" Taskfile.api.yml; then
  printf '\n' >>Taskfile.api.yml
  cat "$parts/Taskfile.api.yml.part" >>Taskfile.api.yml
fi
if ! grep -qF "fakeservices: Taskfile.fakeservices.yml" Taskfile.yml; then
  perl -0pi -e 's/(  catchup: Taskfile\.catchup\.yml\n)/$1  fakeservices: Taskfile.fakeservices.yml\n/' Taskfile.yml
fi
if ! grep -qF "task fakeservices:run" .tmuxp.yaml; then
  perl -0pi -e 's/(      - task catchup:run\n)/$1      - task fakeservices:run\n/' .tmuxp.yaml
fi
# the catchup service is the last service, and its environment is its last key
if ! grep -qF "  fakeservices:" docker-compose.local.yml; then
  cat "$parts/docker-compose.local.yml.part" >>docker-compose.local.yml
fi
if [ ! -f Dockerfile.fakeservices ]; then
  sed 's/catchup/fakeservices/g' Dockerfile.catchup >Dockerfile.fakeservices
fi
rm -rf "$parts"

# golang-migrate applies no migration that is older than the version of the database
latest=$(ls migrations/*.up.sql | grep -v -e create-payments-table -e create-payment-deadlines-table | sed 's#^migrations/##; s#_.*##' | sort | tail -1)
offset=0
for name in create-payments-table create-payment-deadlines-table; do
  for added in migrations/*_"$name".up.sql; do
    version=${added#migrations/}
    version=${version%%_*}
    if [ "$latest" \> "$version" ]; then
      now=$(($(date -u +%Y%m%d%H%M%S) + offset))
      for f in migrations/"$version"_"$name".*; do
        mv "$f" "migrations/$now${f#migrations/$version}"
      done
    fi
  done
  offset=$((offset + 1))
done

if [ "$failed" != 0 ]; then
  exit 1
fi

go build ./...
