FROM golang:{{ .Scaffold.GoVersion }} AS build-env
WORKDIR /build

ARG VERSION=main

COPY go.mod go.sum ./
RUN --mount=type=cache,target=/go/pkg/mod go mod download

COPY internal internal
COPY cmd/fakeservices cmd/fakeservices

RUN --mount=type=cache,target=/go/pkg/mod \
    GOOS=linux \
    CGO_ENABLED=0 \
      go build --ldflags "-extldflags -static -X 'github.com/hpcsc/{{ .ProjectKebab }}/internal/api/use_cases/root.Version=${VERSION}'" \
        -o fakeservices \
        ./cmd/fakeservices

FROM gcr.io/distroless/static
WORKDIR /app

COPY --from=build-env /build/fakeservices .

ENTRYPOINT ["/app/fakeservices"]
